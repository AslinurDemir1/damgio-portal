@model IEnumerable<Damgio.Core.Entities.LoyaltyProgram>

@{
    ViewData["Title"] = "Damga Programları";
    var currentShop = ViewData["CurrentShop"] as Damgio.Core.Entities.Shop;
    var shopId = ViewData["ShopId"] as int?;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">
                @if (currentShop != null)
                {
                    <span>@currentShop.Name &mdash; Programları</span>
                }
                else
                {
                    <span>Tüm Damga Programları</span>
                }
            </h1>
            <p class="text-muted mb-0">Sadakat programları, gerekli damga hedefleri ve ödüller</p>
        </div>
        <div>
            <a asp-action="Create" asp-route-shopId="@shopId" class="btn btn-primary">
                + Yeni Program Ekle
            </a>
            @if (currentShop != null)
            {
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Tümünü Göster</a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <p class="mb-3">Henüz kayıtlı bir damga programı bulunmuyor.</p>
                    <a asp-action="Create" asp-route-shopId="@shopId" class="btn btn-outline-primary btn-sm">İlk Programı Ekle</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Program Adı</th>
                                <th>İşletme</th>
                                <th>Gerekli Damga</th>
                                <th>Kazanılacak Ödül</th>
                                <th>Soğuma</th>
                                <th>Aktif Kartlar</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                            @item.Name
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-controller="Shops" asp-action="Details" asp-route-id="@item.ShopId" class="text-decoration-none">
                                            @item.Shop?.Name
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@item.RequiredStamps Damga</span>
                                    </td>
                                    <td class="text-success fw-semibold">
                                        🎁 @item.RewardName
                                    </td>
                                    <td class="text-muted small">
                                        @item.StampCooldownSeconds sn
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.StampCards.Count Müşteri
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Detay">Detay</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Düzenle">Düzenle</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Sil">Sil</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
