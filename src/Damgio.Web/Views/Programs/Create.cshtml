@model Damgio.Web.Models.Admin.ProgramInputModel

@{
    ViewData["Title"] = "Yeni Damga Programı";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Programlar</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Program</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h2 class="h4 mb-0">Yeni Damga Programı Oluştur</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="ShopId" class="form-label fw-bold"></label>
                            <select asp-for="ShopId" class="form-select" asp-items="ViewBag.ShopList">
                                <option value="">-- Bir İşletme Seçin --</option>
                            </select>
                            <span asp-validation-for="ShopId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: 7 Kahveye 1 Bedava" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="RequiredStamps" class="form-label fw-bold"></label>
                                <input asp-for="RequiredStamps" class="form-control" type="number" min="1" max="50" />
                                <div class="form-text">Ödül için gereken damga adedi (1 ile 50 arası).</div>
                                <span asp-validation-for="RequiredStamps" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StampCooldownSeconds" class="form-label fw-bold"></label>
                                <input asp-for="StampCooldownSeconds" class="form-control" type="number" min="0" />
                                <div class="form-text">İki damga arası bekleme süresi (Varsayılan: 180 sn).</div>
                                <span asp-validation-for="StampCooldownSeconds" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RewardName" class="form-label fw-bold"></label>
                            <input asp-for="RewardName" class="form-control" placeholder="Örn: 1 Ücretsiz Filtre Kahve / Çay" />
                            <span asp-validation-for="RewardName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary px-4">Programı Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
