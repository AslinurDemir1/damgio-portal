@model Damgio.Core.Entities.Shop

@{
    ViewData["Title"] = "İşletme Aktif Değil";
}

<div class="mobile-card-container text-center py-5">
    <div class="damgio-card">
        <div class="fs-1 mb-3">⏸️</div>
        <h3 class="fw-bold text-warning mb-2">@Model.Name</h3>
        <p class="text-muted">
            Bu işletme şu anda hizmete veya yeni damga işlemlerine geçici olarak kapalıdır.
        </p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="damgio-btn-primary">
                Ana Sayfaya Dön
            </a>
        </div>
    </div>
</div>
